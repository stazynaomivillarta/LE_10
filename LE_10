#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main() {
    FILE *file;
    int idNumber, choice;
    char fullName[100], section[50];

    file = fopen("/tmp/student_records.txt", "a+");
    
    if (file == NULL) {
        printf("Error opening file!\n");
        return 1;
    }

    do {
        printf("Enter Student Number: ");
        scanf("%d", &idNumber);
        getchar();

        printf("Enter Complete Name: ");
        fgets(fullName, 100, stdin);
        fullName[strcspn(fullName, "\n")] = 0;

        printf("Enter Section: ");
        fgets(section, 50, stdin);
        section[strcspn(section, "\n")] = 0;

        fprintf(file, "ID Number: %d\n", idNumber);
        fprintf(file, "Complete Name: %s\n", fullName);
        fprintf(file, "Section: %s\n\n", section);

        printf("Record added and saved successfully.\n\n");

        printf("Add another student? [Enter 1 for Yes, 0 for No]: ");
        scanf("%d", &choice);
        printf("\n");

    } while (choice == 1);

    printf("All student records have been saved.\n");

    fclose(file);
    return 0;
}
